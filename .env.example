# Postgres (use docker-compose or local install)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wa_automation

# Backend
BACKEND_PORT=4100
FRONTEND_ORIGIN=http://localhost:3100

# Frontend — REST + Socket.io base URL. Unset defaults to http://localhost:4100.
# From a phone on your network, set to http://<your-computer-LAN-IP>:4100 (not localhost).
NEXT_PUBLIC_BACKEND_URL=

# TypeORM: in production set false and use migrations. If unset, the backend enables sync in dev.
TYPEORM_SYNC=true

# Auto-reply (IPL tickets) — used to seed `auto_reply_settings` id=1 on first run; edit in UI after.
AUTO_REPLY_ENABLED=true
AUTO_REPLY_BUY=true
AUTO_REPLY_SELL=true
# When true (default), auto-reply sends on match mention alone; buy/sell toggles are ignored.
AUTO_REPLY_IGNORE_INTENT=true
AUTO_REPLY_MATCHES=MI vs CSK,RCB vs GT,DC vs RCB
AUTO_REPLY_COOLDOWN_MINUTES=60
AUTO_REPLY_TEXT=Hi! Saw your message about the match. I may be able to help — please share details.
